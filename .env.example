# Copy to backend/.env and fill in. NEVER commit .env.
#
#   cd backend && cp ../.env.example .env
#
# IMPORTANT: this file lives at the repo root, but the loader ONLY reads
# `backend/.env` (see BACKEND_DIR in backend/app/config.py). A .env left at the
# repo root is silently ignored -- no error, no warning, it simply does nothing.
# If JWT_SECRET appears unset after you filled it in, this is why.
#
# Every value below is OPTIONAL. The backend starts, serves the catalog, and
# runs the degree audit with no .env at all.

# Which provider the advisor uses:
#   "anthropic" | "openai" | "gemini" | "ollama"
# Set to whichever student credits came through. NONE OF THIS IS REQUIRED: with
# no provider at all the advisor still answers every question, because the
# answers are computed by the degree engine and a model only rephrases them.
# See docs/advisor.md.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model ids per provider (override if credits restrict you to a tier)
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-sonnet-5
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Ollama: a model running on this machine ---
# Needs no key and no credits, which makes it the fallback when nothing else is
# available. Set LLM_PROVIDER=ollama, then:  ollama pull llama3.1
# The advisor probes this server on every /advisor/health, so an Ollama that is
# not running degrades exactly like an expired key: engine answers, with a note.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1
# A local model on CPU is slow. A demo that hangs is worse than one that says
# the model timed out.
OLLAMA_TIMEOUT_SECONDS=60

# --- Voice input: Deepgram speech-to-text ---
# Optional. Empty = no mic button, and typing works exactly as before. The key
# stays on the server; the browser never sees it. Audio is sent with
# mip_opt_out=true so Deepgram does not keep it for model training.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIMEOUT_SECONDS=20

# Which speech vendor handles voice: deepgram (default, streaming) or openai
# (records, then transcribes once; reuses OPENAI_API_KEY above).
SPEECH_PROVIDER=deepgram
OPENAI_STT_MODEL=gpt-4o-transcribe

# Turns of chat history kept per session, in memory only.
ADVISOR_HISTORY_TURNS=12

# Hard safety cap so a runaway loop cannot burn the team's credits
MAX_TOKENS_PER_SESSION=50000

# Leave DATABASE_URL and CATALOG_DIR commented out unless you truly need to move
# them. Both are resolved relative to your CURRENT WORKING DIRECTORY, while the
# built-in defaults are absolute paths derived from the repo layout itself. The
# defaults are correct from any directory; these overrides are only correct when
# you launch from `backend/`.
# DATABASE_URL=sqlite:///./advisor.db
# CATALOG_DIR=../data/catalog

CORS_ORIGINS=http://localhost:5173

# --- Authentication ---
# Signs access tokens. Generate your own and NEVER commit the real value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it blank and the server generates a throwaway secret per process, which
# is safe but signs everyone out on restart. There is deliberately no default
# here: a committed default would be a published signing key.
JWT_SECRET=

# Hours, not weeks. Tokens are stateless and cannot be revoked before they
# expire, so this IS the revocation window.
ACCESS_TOKEN_TTL_MINUTES=720

# One JSON file per account, like the student records.
USER_DIR=./accounts

# Failed sign-ins from one client against one address before a cooldown starts.
LOGIN_MAX_FAILURES=5
# First cooldown in seconds. Doubles on each further lockout for the same pair...
LOGIN_COOLDOWN_SECONDS=30
# ...up to this ceiling, so a lockout is never permanent.
LOGIN_COOLDOWN_MAX_SECONDS=900
# An idle client/address pair is forgotten after this, clearing its history.
LOGIN_FORGET_AFTER_SECONDS=900
